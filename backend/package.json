{
  "name": "team-task-manager-backend",
  "version": "1.0.0",
  "description": "Backend for Team Task Manager",
  "main": "server.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --experimental-sqlite server.js",
    "dev": "nodemon --exec \"node --experimental-sqlite\" server.js",
